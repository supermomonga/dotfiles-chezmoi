# Machine-global config

[plugins]
lua-bin = "https://github.com/supermomonga/mise-plugin-lua-bin"

[tools]
# Runtime
bun = "1.3.13" # 1.3.14 causes error
deno = "latest"
go = "latest"
node = "latest"
python = "latest"
rust = "latest"
zig = "latest"

# for Neovim compatibility, use v5.1
{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") }}
lua = { version = "5.1", os = ["linux", "macos"] }
{{- end }}

{{- if eq .chezmoi.os "windows" }}
#lua-bin = { version = "5.1", os = ["windows"] }
{{- end }}

# Tools
fzf = "latest"
neovim = "latest"
ripgrep = "latest"
starship = "latest"
tree-sitter = "latest"
uv = "latest"
yazi = "latest"
jq = "latest"
yq = "latest"
aws-cli = "latest"

# Packages
"cargo:pik" = "latest"

{{ if ne .chezmoi.os "windows" }}
"cargo:ultraman" = { version = "latest", os = ["linux", "macos"] }
{{ end }}

"github:BinFlip/dotscope" = { version = "latest" }
"github:k1LoW/mo" = { version = "latest", os = ["windows", "linux", "macos"] }
"github:stripe/stripe-cli" = { version = "latest", os = ["windows", "linux", "macos"] }
"github:router-for-me/CLIProxyAPI" = { version = "latest", os = ["linux", "macos", "windows"] }
"github:prskr/git-age" = "latest"
"github:rtk-ai/rtk" = { version = "latest" }
"github:supermomonga/papers-cli" = { version = "0.0.5" }
"github:wezterm/wezterm" = {
  version = "nightly",
  prerelease = true,
  platforms = {
    "windows-x64" = { asset_pattern = "WezTerm-windows-nightly.zip" },
    "macos-x64" = { asset_pattern = "WezTerm-macos-nightly.zip" },
    "macos-arm64" = { asset_pattern = "WezTerm-macos-nightly.zip" },
    "linux-x64" = { asset_pattern = "WezTerm-nightly-Ubuntu20.04.AppImage" },
  },
}
"go:github.com/babarot/gomi" = "latest"
"go:github.com/k1LoW/git-wt" = "latest"
# temporary disabled.
# use `go install github.com/syou6162/cchook@latest` instead.
# ref: https://github.com/jdx/mise/discussions/6737
#"go:github.com/syou6162/cchook" = "latest"
{{ if ne .chezmoi.os "windows" }}
"go:github.com/Warashi/cage" = { version = "latest", os = ["linux", "macos"] }
{{ end }}
"go:github.com/x-motemen/ghq" = "latest"
"npm:agent-browser" = "latest"
"npm:kanban" = "latest"
"npm:opencode-ai" = "latest"
"npm:rulesync" = "latest"
"npm:sentry" = "latest"
"npm:takt" = "latest"
"npm:task-master-ai" = "latest" # for Cloud CLI
"npm:vibe-kanban" = "latest"
"npm:yepanywhere" = "latest"
"pipx:apm-cli" = "latest"
"pipx:llmstxt2skill" = "latest"
"pipx:edge-tts" = "latest"



[settings]
experimental = true
trusted_config_paths = [
    "~/ghq",
]

[settings.npm]
package_manager = "bun"

[env]
# v3.13.0 broken now https://github.com/luarocks/luarocks/issues/1851
LUAROCKS_VERSION = "3.12.2"

[tasks.sync-rule]
description = "Sync agents' rules from claude code to others"
run = 'rulesync import -t claudecode -f "*" -V; rulesync generate -t "codexcli,opencode" -f "*" -V'

[tasks.sync-rule-global]
description = "Sync agents' rules from claude code to others"
run = 'rulesync import -g -t claudecode -f "*" -V; rulesync generate -g -t "codexcli,opencode" -f "*" -V'

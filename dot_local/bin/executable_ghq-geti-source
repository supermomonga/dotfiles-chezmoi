#!/usr/bin/env bash
# `ghq geti` の fzf 候補を検索クエリに応じて出力する
#
#   (通常)        自分のリポジトリ一覧
#   @hoge         hoge から始まるユーザー一覧
#   @hoge/...     hoge のリポジトリ一覧
set -uo pipefail

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ghq-geti"
mkdir -p "$cache_dir"
# reload で中断されたときに書きかけのキャッシュを残さない
trap 'rm -f "$cache_dir"/*."$$"' EXIT
trap 'exit 1' TERM INT HUP

# コマンドの出力を 10 分間キャッシュする
cached() {
  local file="$cache_dir/$1"
  shift
  if [[ -z "$(find "$file" -mmin -10 2>/dev/null)" ]]; then
    "$@" > "$file.$$" && mv "$file.$$" "$file" || rm -f "$file.$$"
  fi
  [[ -f "$file" ]] && cat "$file"
}

# usage: list_repos <owner (空なら自分)> <行頭に付ける prefix>
list_repos() {
  gh repo list ${1:+"$1"} --limit 1000 --json nameWithOwner,description \
    | jq -r --arg p "$2" '.[] | [$p + .nameWithOwner, (.description // "")] | @tsv'
}

debounce_sec=0.4
throttle_us=2000000 # Search API の上限 (30 回/分) に収まる間隔

now_us() {
  if [[ -n "${EPOCHREALTIME:-}" ]]; then
    echo "${EPOCHREALTIME/[.,]/}"
  else
    echo "$(date +%s)000000"
  fi
}

# リクエスト前に debounce と throttle の待ちを入れる
# 待っている間に次の入力があれば fzf がこのプロセスを止めるので、最後の入力だけがリクエストされる
wait_for_request() {
  local last_file="$cache_dir/.last-request"
  local last wait_us
  sleep "$debounce_sec"
  last="$(cat "$last_file" 2>/dev/null || echo 0)"
  wait_us=$(( last + throttle_us - $(now_us) ))
  if (( wait_us > 0 )); then
    sleep "$(printf '%d.%06d' $(( wait_us / 1000000 )) $(( wait_us % 1000000 )))"
  fi
  now_us > "$last_file"
}

search_users() {
  wait_for_request
  gh api -X GET search/users -f q="$1 in:login" -f per_page=50 \
    | jq -r --arg q "$1" '.items[].login | select(ascii_downcase | startswith($q | ascii_downcase)) | "@" + .'
}

# クエリに対応する候補の種類
mode_key() {
  case "$1" in
    @*/*) local owner="${1#@}"; echo "repos-@${owner%%/*}" ;;
    @?*) echo "users-${1#@}" ;;
    @) echo "none" ;;
    *) echo "repos-self" ;;
  esac
}

# usage: ghq-geti-source --on-change <state file> <query>
# 候補の種類が変わったときだけ reload を指示する (fzf の transform 用)
if [[ "${1:-}" == "--on-change" ]]; then
  key="$(mode_key "${3:-}")"
  if [[ "$key" != "$(cat "$2" 2>/dev/null)" ]]; then
    printf '%s' "$key" > "$2"
    echo "reload:ghq-geti-source {q}"
  fi
  exit
fi

query="${1:-}"
case "$query" in
  @*/*)
    owner="${query#@}"
    owner="${owner%%/*}"
    cached "repos-@$owner" list_repos "$owner" "@"
    ;;
  @?*)
    prefix="${query#@}"
    cached "users-$prefix" search_users "$prefix"
    ;;
  @)
    ;;
  *)
    cached "repos-self" list_repos "" ""
    ;;
esac

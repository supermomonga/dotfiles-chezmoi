#!/bin/bash
# WezTerm の BELL ユーザー変数に絵文字を送信してタブタイトルに通知を表示する
# Usage: wezterm-bell [emoji]
#   emoji: 表示する文字 (省略時: 🔔)
#
# WezTerm Lua 側で累積管理されるため、同じ文字を複数回送っても重複しない。
# 異なる文字を送ると並んで表示される (例: 🔔💭)
# クリアは WezTerm がフォーカス/タブ切り替えを検知した際に自動で行われる。

EMOJI="${1:-🔔}"

# tty を取得（tmux 内の場合はクライアントの tty を使って tmux をバイパスする）
if [ -n "${TMUX:-}" ]; then
    tty="$(tmux display-message -p '#{client_tty}')"
else
    tty="/dev/tty"
fi

# tty が取れない場合は WezTerm 外とみなして何もしない
[ -z "$tty" ] && exit 0

encoded=$(printf '%s' "$EMOJI" | base64 | tr -d '\n')
printf '\033]1337;SetUserVar=%s=%s\007' "BELL" "$encoded" > "$tty"

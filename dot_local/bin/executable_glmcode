#!/usr/bin/env bun
// Z.AI API Configuration
process.env.ANTHROPIC_BASE_URL = "https://api.z.ai/api/anthropic";
process.env.ANTHROPIC_AUTH_TOKEN = process.env.GLM_API_KEY;
process.env.API_TIMEOUT_MS = "3000000";

// Model mappings (GLM models)
process.env.ANTHROPIC_DEFAULT_OPUS_MODEL = "GLM-5.1";
process.env.ANTHROPIC_DEFAULT_SONNET_MODEL = "GLM-5.1";
process.env.ANTHROPIC_DEFAULT_HAIKU_MODEL = "GLM-5-TURBO";
process.env.CLAUDE_AUTOCOMPACT_PCT_OVERRIDE = "75";

// Handled by Stop hook
if (Bun.argv.includes("--team-name")) {
  process.env.CLAUDE_CODE_IS_TEAMMATE = "1";
}

const proc = Bun.spawn(["claude", ...Bun.argv.slice(2)], {
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
  env: process.env,
});
process.exitCode = await proc.exited;

# Generated by chezmoi — do not edit manually

# --- Vultr ---
{{- if env "VULTR_API_KEY" }}
{{- $vultrData := output "vultr-cli" "instance" "list" "--output=json" | fromJson }}
{{- range $vultrData.instances }}

Host {{ .label | kebabcase }}
    HostName {{ .main_ip }}
    Port 22
    User {{ if eq .user_scheme "root" }}root{{ else }}linuxuser{{ end }}
    ForwardAgent yes
    TCPKeepAlive yes
    PasswordAuthentication no
{{- end }}
{{- else }}
# VULTR_API_KEY is not set — no Vultr hosts generated
{{- end }}

# --- Contabo ---
{{- if and (lookPath "cntb") (lookPath "op") }}
{{- $cntbData := output "cntb" "get" "instances" "--output" "json" | fromJson }}
{{- range $cntbData }}

Host {{ .displayName | kebabcase }}
    HostName {{ .ipv4 }}
    Port 22
    User {{ .defaultUser }}
    ForwardAgent yes
    TCPKeepAlive yes
    PasswordAuthentication {{ if eq .defaultUser "root" }}yes{{ else }}no{{ end }}
{{- end }}
{{- else }}
# cntb or op is not available — no Contabo hosts generated
{{- end }}

# --- GreenCloud ---
{{- if lookPath "op" }}
{{- $gcApiKey := onepasswordRead "op://chezmoi/devenv/GREENCLOUD_API_KEY" -}}
{{- $gcData := output "curl" "-sf" "https://cp.green.cloud/api/server" "-H" "Accept: application/json" "-H" (printf "Authorization: Bearer %s" $gcApiKey) | fromJson -}}
{{- range $gcData.data }}

Host {{ .name | kebabcase }}
    HostName {{ (index .network.primary.ipv4 0).address }}
    Port 22
    User main
    ForwardAgent yes
    TCPKeepAlive yes
{{- end }}
{{- else }}
# op is not available — no GreenCloud hosts generated
{{- end }}

# --- devenv (1Password) ---
{{- if lookPath "op" }}
{{- $devenvItems := output "op" "item" "list" "--categories" "server" "--vault" "chezmoi" "--format" "json" | fromJson }}
{{- range $devenvItems }}
{{-   if hasPrefix "devenv:" .title }}
{{-     $name := trimPrefix "devenv:" .title }}
{{-     $ref := printf "op://chezmoi/%s" .id }}
{{-     $hostname := onepasswordRead (printf "%s/URL" $ref) }}
{{-     $username := onepasswordRead (printf "%s/username" $ref) }}
{{-     $port := "22" }}
{{-     $item := output "op" "item" "get" .id "--vault" "chezmoi" "--format" "json" | fromJson }}
{{-     range $item.fields }}
{{-       if eq .id "port" }}{{ $port = .value }}{{ end }}
{{-     end }}

Host {{ $name }}
    HostName {{ $hostname }}
    Port {{ $port }}
    User {{ $username }}
    ForwardAgent yes
    TCPKeepAlive yes
{{-   end }}
{{- end }}
{{- else }}
# op is not available — no devenv hosts generated
{{- end }}

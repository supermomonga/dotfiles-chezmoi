{{- /* Get ghq root and authenticated GitHub users */ -}}
{{- $ghqRoot := output "ghq" "root" | trim -}}
{{- $ghAuth := output "gh" "auth" "status" "--json" "hosts" | fromJson -}}
{{- $repos := output "ghq" "list" | trim | splitList "\n" -}}
dataDir: ~/.agent-orchestrator
worktreeDir: ~/.worktrees
port: 3000
defaults:
  runtime: tmux
  agent: claude-code
  workspace: worktree
  notifiers:
    - slack

notifiers:
  slack:
    plugin: slack
    webhook: ${AO_SLACK_WEBHOOK_URL}
    channel: "#dev-ao"

projects:
{{- range $repos }}
{{-   if eq . "" }}{{ continue }}{{ end }}
{{-   $parts := splitList "/" . }}
{{-   if lt (len $parts) 3 }}{{ continue }}{{ end }}
{{-   $host := index $parts 0 }}
{{-   $owner := index $parts 1 }}
{{-   $repoName := index $parts 2 }}
{{-   if not (hasKey $ghAuth.hosts $host) }}{{ continue }}{{ end }}
{{-   $isOwned := false }}
{{-   range (index $ghAuth.hosts $host) }}
{{-     if eq .login $owner }}{{ $isOwned = true }}{{ end }}
{{-   end }}
{{-   if not $isOwned }}{{ continue }}{{ end }}
{{-   $repoPath := printf "%s/%s" $ghqRoot . }}
{{-   $checks := output "sh" "-c" (printf "cd '%s' && echo \"$(test -f mise.toml -o -f mise.local.toml && echo 1 || echo 0):$(test -f .agent-rules.md && echo 1 || echo 0):$(test -f mise.local.toml && echo 1 || echo 0):$(test -d .claude && echo 1 || echo 0)\"" $repoPath) | trim | splitList ":" }}
{{-   $hasMise := eq (index $checks 0) "1" }}
{{-   $hasAgentRules := eq (index $checks 1) "1" }}
{{-   $hasMiseLocal := eq (index $checks 2) "1" }}
{{-   $hasClaude := eq (index $checks 3) "1" }}
{{-   $symlinks := list }}
{{-   if $hasMiseLocal }}{{ $symlinks = append $symlinks "mise.local.toml" }}{{ end }}
{{-   if $hasClaude }}{{ $symlinks = append $symlinks ".claude" }}{{ end }}
  {{ $repoName }}:
    name: {{ $repoName }}
    repo: {{ $owner }}/{{ $repoName }}
    path: ~/ghq/{{ . }}
    defaultBranch: main
{{-   if gt (len $symlinks) 0 }}
    symlinks: [{{ join ", " $symlinks }}]
{{-   end }}
{{-   if $hasMise }}
    postCreate:
      - "mise install"
{{-   end }}
{{-   if $hasAgentRules }}
    agentRulesFile: .agent-rules.md
{{-   end }}
    reactions:
      approved-and-green:
        auto: true
{{- end }}

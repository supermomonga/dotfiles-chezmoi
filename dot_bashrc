# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac


export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

shopt -s autocd
shopt -s dotglob

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=100000
HISTFILESIZE=10000000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    # We have color support; assume it's compliant with Ecma-48
    # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
    # a case would tend to support setf rather than setaf.)
    color_prompt=yes
    else
    color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

source ~/.config/wezterm/wezterm.sh

is_wsl() {
  # 1. 環境変数（最速）
  if [ -n "$WSLENV" ]; then
    return 0
  fi

  # 2. /proc/version（WSL1 / WSL2 両対応・定番）
  if [ -r /proc/version ] && grep -qi microsoft /proc/version; then
    return 0
  fi

  # 3. /run/WSL（WSL2 + systemd）
  if [ -d /run/WSL ]; then
    return 0
  fi

  return 1
}

# Use Windows host machine's 1Password SSH Agent
setup_op_ssh_agent() {
  export SSH_AUTH_SOCK=$HOME/.ssh/agent.sock
  if ! ssh-add -l >/dev/null 2>&1; then
    pkill -f "socat.*$SSH_AUTH_SOCK" 2>/dev/null
    rm -f "$SSH_AUTH_SOCK"
    nohup socat UNIX-LISTEN:"$SSH_AUTH_SOCK",fork EXEC:"npiperelay.exe -ei -s //./pipe/openssh-ssh-agent" >/dev/null 2>&1 &
  fi
}

if is_wsl; then
  setup_op_ssh_agent
  export BROWSER=wslview
fi

# tmux セッション名を WezTerm user var として通知
if [ -n "$TMUX" ] && [ -z "$NVIM" ]; then
  __wezterm_set_user_var TMUX_SESSION "$(tmux display-message -p '#S')"
fi

# neovim 内のターミナルが OSC 1337 を理解できず
# そのまま文字として表示されてしまうため無効化
if [ -n "$NVIM" ]; then
  export WEZTERM_SHELL_SKIP_USER_VARS=1
fi

if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
elif [ -x "/opt/homebrew/bin/mise" ]; then
  eval "$(/opt/homebrew/bin/mise activate bash)"
fi

eval "$(git wt --init bash)"

export EDITOR=nvim

tn() { tmux new -s "${1:-main}"; }
ta() { tmux a -t "${1:-main}"; }
alias ts="tmuxist start"
alias tk="tmuxist kill"
alias rl="source ~/.bashrc"
alias gs="git status"
alias gd="git diff"
alias che="chezmoi"

alias ao="$(mise ls node --json -C "$(ghq root)/github.com/ComposioHQ/agent-orchestrator" | jq -r '.[0].install_path')/bin/ao"
alias ccd="cage claude --allow-dangerously-skip-permissions"
alias glmd="cage glmcode --allow-dangerously-skip-permissions"
alias co="cage codex"
alias cod="cage codex --yolo"

list_path() {
  local selected
  selected=$(printf '%s\n' "$PATH" \
    | tr ':' '\n' \
    | tac \
    | fzf --prompt="Select PATH (bottom = higher priority) > ")

  if [ -n "$selected" ]; then
    if command -v pbcopy >/dev/null 2>&1; then
      printf '%s' "$selected" | pbcopy
    elif command -v xclip >/dev/null 2>&1; then
      printf '%s' "$selected" | xclip -selection clipboard
    elif command -v wl-copy >/dev/null 2>&1; then
      printf '%s' "$selected" | wl-copy
    else
      echo "No clipboard command found"
      return 1
    fi
    echo "Copied: $selected"
  fi
}
alias lspath='list_path'

function repo_list() {
  local repo
  repo=$( { ghq list | grep -Ev -- '-worktrees/[^/]+$'; echo '.local/share/chezmoi'; } | fzf) || return
  if [[ "$repo" == '.local/share/chezmoi' ]]; then
    cd "$HOME/.local/share/chezmoi"
  else
    cd "$(ghq root)/$repo"
  fi
}
alias g="repo_list"

function git_worktree_list() {
  local select
  local repo
  select=$(git-wt | sed 1d | fzf ) || return
  repo=$(awk '{print $1}' <<< $select)
  cd $repo
}
alias gw="git_worktree_list"

function attach_tmux_session_list() {
  local session
  session=$(tmux list-sessions -F '#{session_name}' | fzf) || return
  tmux a -t "$session"
}
alias tl="attach_tmux_session_list"

eval "$(starship init bash)"
starship preset pure-preset -o ~/.config/starship/presets/pure.toml

export PATH="$HOME/.local/bin:$PATH"

if [ -f ~/.local_bashrc ]; then
  . ~/.local_bashrc
fi

# Workaround to disable spawn powershell by Claude Code repeatedly.
# ref: https://github.com/anthropics/claude-code/issues/14352
if is_wsl; then
  export CLAUDE_CODE_SKIP_WINDOWS_PROFILE=1
  if [ -d "/mnt/c/Users/$(whoami)" ]; then
    export USERPROFILE="/mnt/c/Users/$(whoami)"
  else
    WIN_USER=$(ls /mnt/c/Users | grep -v -E 'Public|Default|All Users|defaultuser0' | head -n1)
    export USERPROFILE="/mnt/c/Users/$WIN_USER"
  fi
fi



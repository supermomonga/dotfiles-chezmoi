{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cchook -event PermissionRequest",
            "async": true
          },
          {
            "type": "command",
            "command": "wezterm-bell 🔔",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cchook -event TaskCompleted",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "true stop",
            "async": false
          },
          {
            "type": "command",
            "command": "wezterm-bell 🔔",
            "async": false
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "dig@kuu-marketplace": true,
    "context7@claude-plugins-official": true,
    "team-builder@claude-code-customes": true
  },
  "language": "Japanese",
  "skipDangerousModePermissionPrompt": true
}

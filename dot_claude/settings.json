{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cchook -event PermissionRequest",
            "async": true
          },
          {
            "type": "command",
            "command": "wezterm-bell 🔔",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cchook -event TaskCompleted",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cchook -event PreToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "true stop",
            "async": true
          },
          {
            "type": "command",
            "command": "wezterm-bell 🔔",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "dig@kuu-marketplace": true,
    "context7@claude-plugins-official": true,
    "team-builder@claude-code-customes": true,
    "x-post@supermomonga-agent-plugins": true,
    "youtube-transcribe@supermomonga-agent-plugins": true,
    "example-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "supermomonga-agent-plugins": {
      "source": {
        "source": "directory",
        "path": "~/ghq/github.com/supermomonga/claude-plugins"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "defaultShell": "powershell",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "language": "Japanese",
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true
}

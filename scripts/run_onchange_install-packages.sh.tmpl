{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

ARCH=$(dpkg --print-architecture)

# Add current user to sudoers (passwordless sudo)
SUDOERS_FILE="/etc/sudoers.d/$USER"
if [[ ! -f "$SUDOERS_FILE" ]] || ! sudo grep -q "^$USER " "$SUDOERS_FILE" 2>/dev/null; then
  echo "$USER ALL=(ALL) NOPASSWD: ALL" | sudo tee "$SUDOERS_FILE" >/dev/null
  sudo chmod 440 "$SUDOERS_FILE"
fi

# Add 1Password CLI repository
# TODO: Environments機能がBetaからStableになったらbetaチャンネルをstableに戻す
# ref: https://developer.1password.com/docs/cli/reference/#beta-builds
# ref: https://app-updates.agilebits.com/product_history/CLI2
# ref: https://www.1password.community/discussions/developers/1password-cli-bug-report-service-account-cannot-read-environments/167547
OP_CHANNEL=beta

ensure_cmd() {
  local cmd=$1; shift
  if [[ $cmd == /* || $cmd == ~/* ]]; then
    eval [[ -f "$cmd" ]] && return
  else
    command -v "$cmd" &>/dev/null && return
  fi
  eval "$@"
}

ensure_file() {
  local file=$1; shift
  [[ -f $file ]] && return
  sudo mkdir -p "$(dirname "$file")"
  "$@" | sudo tee "$file" >/dev/null
}

ensure_file_content() {
  local file=$1; shift
  local content
  content=$("$@")
  if [[ ! -f "$file" ]] || [[ "$(cat "$file")" != "$content" ]]; then
    sudo mkdir -p "$(dirname "$file")"
    echo "$content" | sudo tee "$file" >/dev/null
  fi
}

OP_KEY=$(curl -sS https://downloads.1password.com/linux/keys/1password.asc)
ensure_file /usr/share/keyrings/1password-archive-keyring.gpg \
  gpg --dearmor <<< "$OP_KEY"
ensure_file_content /etc/apt/sources.list.d/1password.list \
  echo "deb [arch=${ARCH} signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/${ARCH} ${OP_CHANNEL} main"
ensure_file /etc/debsig/policies/AC2D62742012EA22/1password.pol \
  curl -sS https://downloads.1password.com/linux/debian/debsig/1password.pol
ensure_file /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg \
  gpg --dearmor <<< "$OP_KEY"

# Add GitHub CLI repository
ensure_file /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  curl -sS https://cli.github.com/packages/githubcli-archive-keyring.gpg
ensure_file_content /etc/apt/sources.list.d/github-cli.list \
  echo "deb [arch=${ARCH} signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main"

# Install missing packages
PACKAGES=(
  libreadline-dev # for lua
  unzip # for lua
  build-essential
  htop
  1password-cli
  gh
  dotnet-sdk-10.0
  # for arXiv document processing
  pandoc
  poppler-utils
)
MISSING=()
for pkg in "${PACKAGES[@]}"; do
  dpkg -s "$pkg" &>/dev/null || MISSING+=("$pkg")
done
if [[ ${#MISSING[@]} -gt 0 ]]; then
  sudo apt update
  sudo apt install -y "${MISSING[@]}"
fi

# ta-lib
if ! dpkg -s ta-lib &>/dev/null; then
  curl -fsSL -o /tmp/ta-lib_0.6.4_${ARCH}.deb \
    "https://github.com/ta-lib/ta-lib/releases/download/v0.6.4/ta-lib_0.6.4_${ARCH}.deb"
  sudo dpkg -i /tmp/ta-lib_0.6.4_${ARCH}.deb
  rm -f /tmp/ta-lib_0.6.4_${ARCH}.deb
fi

ensure_cmd ~/.local/bin/mise 'curl https://mise.run | sh'
ensure_cmd claude 'curl -fsSL https://claude.ai/install.sh | bash'
ensure_cmd tailscale 'curl -fsSL https://tailscale.com/install.sh | sh'

# Docker
if ! command -v docker &>/dev/null; then
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc

  CODENAME=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
  sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null <<SOURCES
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: ${CODENAME}
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
SOURCES

  sudo apt update
  sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

# Docker post-install: non-root user
if ! groups "$USER" | grep -qw docker; then
  sudo groupadd -f docker
  sudo usermod -aG docker "$USER"
fi

# Docker post-install: start on boot
if command -v docker &>/dev/null; then
  sudo systemctl enable docker.service
  sudo systemctl enable containerd.service
fi

# Docker post-install: log rotation
DOCKER_DAEMON_JSON=/etc/docker/daemon.json
if [[ ! -f "$DOCKER_DAEMON_JSON" ]]; then
  sudo mkdir -p /etc/docker
  sudo tee "$DOCKER_DAEMON_JSON" >/dev/null <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
JSON
fi


{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
#brew install ripgrep

ensure_cmd() {
  local cmd=$1; shift
  case "$cmd" in
    /*|~/*) eval [ -f "$cmd" ] && return ;;
    *) command -v "$cmd" >/dev/null 2>&1 && return ;;
  esac
  eval "$@"
}

ensure_cmd ~/.local/bin/mise 'curl https://mise.run | sh'
ensure_cmd gh 'brew install gh'
ensure_cmd claude 'brew install --cask claude-code'


{{ end -}}
